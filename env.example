# این فایل مثال متغیرهای محیطی برایbackend است.
# مقادیر واقعی را در فایل .env قرار دهید و این فایل را commit نکنید.
# DATABASE_URL: رشته اتصال به PostgreSQL
# JWT_SECRET: کلید مخفی برای امضای توکن JWT (حداقل 32 کاراکتر)
# PORT: پورت که سربر/backend روی آن گوش می‌دهد

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=a_strong_random_string_min_32_chars
PORT=4000
